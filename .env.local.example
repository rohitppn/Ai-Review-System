# Anthropic — Claude API key (Haiku 4.5 used for review generation)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Public site URL — used to build the QR code link
# Dev (LAN scan from phone): http://192.168.x.x:3000
# Prod: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps API key — powers the Places search in onboarding step 3.
# Without this set, the wizard falls back to manual URL paste.
# Setup:
#   1. console.cloud.google.com → create project → enable
#      "Places API (New)" + "Maps JavaScript API"
#   2. Credentials → API key
#   3. Restrict the key (referrer): *.vercel.app/*, localhost/*, rohitppn.github.io/*
#   4. Restrict the key (API): the two APIs above
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Admin contact — surfaced in the WhatsApp deep-link + UPI ID display on
# step 7 of the wizard (and in the dashboard "send screenshot" link).
# WhatsApp must include the country code with no '+' or spaces (e.g. 917717766954).
NEXT_PUBLIC_ADMIN_WHATSAPP=917717766954
NEXT_PUBLIC_ADMIN_UPI_ID=rohitsharmabusy@oksbi
